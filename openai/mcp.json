{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "soundlink": {
      "type": "streamable-http",
      "url": "https://api.getsoundlink.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "campaigns:read",
              "metrics:read",
              "soundlinks:read",
              "wallet:read"
            ]
          }
        }
      }
    }
  }
}
